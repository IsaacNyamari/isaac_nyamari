# ── Core ─────────────────────────────────────────────────────────────
# PostgreSQL connection string. Local dev: `npm run db:local` starts one on port 5544.
DATABASE_URL="postgresql://isaac:isaac_local_dev@localhost:5544/isaac"
# Public base URL of the site (no trailing slash). Used for auth, canonical URLs and sitemap.
SITE_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=""

# ── Initial administrator (used by `npm run admin:create`) ─────────────
ADMIN_NAME="Isaac Nyamari"
ADMIN_EMAIL=""
# At least 12 characters. Remove from the environment after provisioning.
ADMIN_PASSWORD=""

# ── Initial public contact details (used once by `npm run db:seed`) ─────
# Leave blank to enter them later in Admin → Settings → Contact.
SEED_CONTACT_EMAIL=""
SEED_CONTACT_PHONE=""
SEED_CONTACT_WHATSAPP=""

# ── Media storage ────────────────────────────────────────────────────
# "local" stores files on disk (needs a persistent volume in production) or "s3".
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage/uploads"
MEDIA_MAX_UPLOAD_MB="10"
# S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO …)
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL that serves the bucket (e.g. https://media.example.com)
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="false"

# ── Email delivery ───────────────────────────────────────────────────
# "console" (logs only, dev), "smtp" or "resend"
EMAIL_DRIVER="console"
EMAIL_FROM="Website <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""

# ── Scheduled publishing ─────────────────────────────────────────────
# Secret for GET/POST /api/cron/publish (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
# "true" runs the publisher inside the Node server every minute (long-running hosts only)
INTERNAL_SCHEDULER="false"
